    {
      "name": "alertas_criticas",
      "displayName": "Alertas Críticas de Producción",
      "queryLines": [
        "SELECT\n",
        "  id_alerta,\n",
        "  id_pozo,\n",
        "  fecha_hora,\n",
        "  presion_psi,\n",
        "  caudal_bpd,\n",
        "  tipo_anomalia,\n",
        "  nivel_riesgo,\n",
        "  requiere_parada_planta\n",
        "FROM\n",
        "  workspace.control_produccion_pozos.vw_alertas_criticas_dashboard"
      ],
      "columns": [
        {
          "displayName": "paradas_requeridas",
          "expression": "SUM(CAST(`requiere_parada_planta` AS INT))"
        }
      ]
    },
    {
      "name": "calidad_datos",
      "displayName": "Calidad de Datos - Sensores",
